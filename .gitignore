# Dependencies
node_modules/
.pnp/
.yarn/

# Logs / temp
*.log
*.tmp
.DS_Store

# Session memory (generated at runtime, not part of the harness source)
.claude/sessions/
.claude/skills-staging/
.claude/traces/
.claude/eval/
harness-sessions/

# Phase 3 Layer 1 — isolated Headroom eval venv (heavy Python dep, never committed)
.claude/headroom-venv/

# Phase 3 Layer 2 — CodeGraph eval artifacts (local install + per-project index, never committed)
.claude/codegraph-install/
.codegraph/

# Phase 3 Layer 2 — codebase-memory-mcp eval artifacts (local binary, never committed).
# NB: the per-project index lives OUTSIDE the repo in ~/.cache/codebase-memory-mcp/ (XDG cache),
# so nothing leaks into the working tree; only the local binary + P0 outputs are here.
.claude/codebase-memory-install/

# Phase 3 evaluation apparatus + benchmark corpus — internal R&D, kept LOCAL (not part of
# the public plugin). The shipped product (skills/hooks/rules/docs) + the two hook tests
# (test-cbm-hook, test-lazy-hook) + the tracked eval module (benchmark.js, checkpoint.js, …)
# are committed; the per-tool pilots/verdicts/setups + corpus + killed-tool scaffolding are not.
/BENCHMARKS.md
/benchmarks/
/scripts/eval/bench-*
/scripts/eval/cbm-*
/scripts/eval/codegraph-*
/scripts/eval/codegraph.json
/scripts/eval/headroom-*
/scripts/eval/lazy-pilot.sh
/scripts/eval/lazy-verdict.js
/scripts/eval/fake-claude.sh
/scripts/eval/probe-claude.sh
/scripts/eval/measure-observation-pool.js
/scripts/eval/test-bench-suite.sh
/scripts/eval/test-cbm-pilot.sh
/scripts/eval/test-cbm-setup.sh
/scripts/eval/test-codegraph-*
/scripts/eval/test-headroom-*
/scripts/eval/test-lazy-pilot.sh

# Local-only secrets / overrides
.env
.env.local
settings.local.json

# Local plugin-activation / IDE state (per-checkout, not harness source)
.claude/settings.json

# Pre-existing tooling artifacts (not part of this harness)
.code-graph/
